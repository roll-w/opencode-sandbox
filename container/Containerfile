ARG UBUNTU_VERSION=24.04
FROM ubuntu:${UBUNTU_VERSION}

# OCI Image Labels
# See: https://github.com/opencontainers/image-spec/blob/main/annotations.md
LABEL org.opencontainers.image.title="OpenCode Sandbox" \
      org.opencontainers.image.description="A lightweight container-based environment for running OpenCode and related tooling in an isolated, reproducible container." \
      org.opencontainers.image.authors="RollW" \
      org.opencontainers.image.vendor="RollW" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.url="https://github.com/roll-w/opencode-sandbox" \
      org.opencontainers.image.source="https://github.com/roll-w/opencode-sandbox" \
      org.opencontainers.image.documentation="https://github.com/roll-w/opencode-sandbox"

ENV DEBIAN_FRONTEND=noninteractive
ENV PLAYWRIGHT_BROWSERS_PATH=/home/opencode/.cache/ms-playwright

# Install base packages
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        wget \
        gnupg \
        lsb-release \
        xdg-utils \
        sudo \
        git \
        jq \
        unzip \
        build-essential \
        python3 \
        python3-pip \
        python3-venv \
        vim \
        tree \
        acl \
        passwd \
    && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get update \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

RUN set -eux; \
    if getent group 1000 >/dev/null 2>&1; then \
        EXISTING_GROUP=$(getent group 1000 | cut -d: -f1); \
        if [ "$EXISTING_GROUP" != "opencode" ]; then \
            groupmod -n opencode "$EXISTING_GROUP"; \
        fi; \
    else \
        groupadd -g 1000 opencode; \
    fi; \
    if getent passwd 1000 >/dev/null 2>&1; then \
        EXISTING_USER=$(getent passwd 1000 | cut -d: -f1); \
        if [ "$EXISTING_USER" != "opencode" ]; then \
            usermod -l opencode -d /home/opencode -m "$EXISTING_USER"; \
        fi; \
    else \
        useradd -m -u 1000 -g opencode -s /bin/bash opencode; \
    fi; \
    mkdir -p /workspace \
             /home/opencode/.config/opencode \
             /home/opencode/.local/share/opencode \
             /home/opencode/.local/state/opencode \
             /home/opencode/.cache/opencode \
             /home/opencode/.bun \
             /home/opencode/.pnpm-store; \
    chown -R opencode:opencode /home/opencode /workspace

RUN npm install -g pnpm@latest \
    && npx playwright install --with-deps chromium \
    && pnpm config set store-dir /home/opencode/.pnpm-store \
    && npm install -g @fission-ai/openspec@latest  \
    && npm install -g agent-browser  \
    && rm -rf /var/lib/apt/lists/*

RUN npm install -g opencode-ai@latest

# Install fixuid for runtime UID/GID adjustment
# See: https://github.com/boxboat/fixuid
RUN ARCH=$(dpkg --print-architecture) && \
    curl -SsL "https://github.com/boxboat/fixuid/releases/download/v0.6.0/fixuid-0.6.0-linux-${ARCH}.tar.gz" | tar -C /usr/local/bin -xzf - && \
    chown root:root /usr/local/bin/fixuid && \
    chmod 4755 /usr/local/bin/fixuid && \
    mkdir -p /etc/fixuid && \
    printf "user: opencode\ngroup: opencode\npaths:\n  - /home/opencode\n" > /etc/fixuid/config.yml

# Allow passwordless sudo for convenience in sandbox
RUN echo "opencode ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/opencode && chmod 0440 /etc/sudoers.d/opencode

WORKDIR /workspace

# Simple entrypoint script
COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

# Switch to non-root user by default
USER opencode:opencode

ENV PATH="/home/opencode/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

# Use fixuid as entrypoint - it will adjust UID/GID and then run the provided command
ENTRYPOINT ["fixuid", "-q", "/usr/local/bin/entrypoint.sh"]
CMD ["bash"]
