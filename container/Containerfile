ARG UBUNTU_VERSION=24.04
FROM ubuntu:${UBUNTU_VERSION}

ENV DEBIAN_FRONTEND=noninteractive

# Install base packages
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        wget \
        gnupg \
        lsb-release \
        xdg-utils \
        sudo \
        git \
        jq \
        unzip \
        build-essential \
        openjdk-17-jdk \
        python3 \
        python3-pip \
        python3-venv \
        vim \
        tree \
        acl \
        passwd \
    && rm -rf /var/lib/apt/lists/*

# Install Node.js (LTS) via NodeSource (Node 20/22 family)
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get update \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

RUN npm install -g pnpm@latest \
    && pnpm config set store-dir /home/opencode/.pnpm-store

RUN npx playwright install-deps chromium  \
    && npm install -g agent-browser  \
    && agent-browser install

RUN npm install -g opencode-ai@latest

ARG USER_UID=1000
ARG USER_GID=1000

RUN set -eux; \
    if getent group "${USER_GID}" >/dev/null 2>&1; then \
        EXISTING_GROUP=$(getent group "${USER_GID}" | cut -d: -f1); \
        [ "${EXISTING_GROUP}" != "opencode" ] && groupmod -n opencode "${EXISTING_GROUP}"; \
    elif getent group opencode >/dev/null 2>&1; then \
        groupmod -g "${USER_GID}" opencode; \
    else \
        groupadd -g "${USER_GID}" opencode; \
    fi; \
    \
    if getent passwd "${USER_UID}" >/dev/null 2>&1; then \
        EXISTING_USER=$(getent passwd "${USER_UID}" | cut -d: -f1); \
        if [ "${EXISTING_USER}" != "opencode" ]; then \
            getent passwd opencode >/dev/null 2>&1 && userdel -f opencode; \
            usermod -l opencode "${EXISTING_USER}"; \
            usermod -d /home/opencode -m opencode; \
        fi; \
    elif getent passwd opencode >/dev/null 2>&1; then \
        usermod -u "${USER_UID}" opencode; \
    else \
        useradd -m -u "${USER_UID}" -g opencode -s /bin/bash opencode; \
    fi; \
    \
    CURRENT_HOME=$(getent passwd opencode | cut -d: -f6); \
        if [ "$CURRENT_HOME" != "/home/opencode" ]; then \
            mkdir -p /home/opencode; \
            chown opencode:opencode /home/opencode; \
            usermod -d /home/opencode opencode; \
        fi; \
    mkdir -p /workspace \
             /home/opencode/.config/opencode \
             /home/opencode/.local/share/opencode \
             /home/opencode/.local/state/opencode \
             /home/opencode/.cache/opencode \
             /home/opencode/.bun \
             /home/opencode/.pnpm-store; \
    chown -R "${USER_UID}:${USER_GID}" /home/opencode /workspace

# Allow passwordless sudo for convenience in sandbox
RUN echo "opencode ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/opencode && chmod 0440 /etc/sudoers.d/opencode

WORKDIR /workspace

# Simple entrypoint script
COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

# Switch to non-root user by default
USER opencode
ENV HOME=/home/opencode
ENV PATH="/home/opencode/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["bash"]
